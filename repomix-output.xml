  --border: #ddd;
  --particle-color: #3498db;
  --particle-line-color: #3498db;
  --footer-color: #804096b7;
}

[data-theme="dark"] {
  --bg-color: #00000089;
  --text-color: #e0e0e0;
  --card-bg: #2d2d2d;
  --nav-bg: #2d2d2d;
